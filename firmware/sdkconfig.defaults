# Arduino-ESP32 requires a 1 kHz FreeRTOS tick when used as an ESP-IDF
# component. Keep this project default explicit and reproducible.
CONFIG_FREERTOS_HZ=1000

# The firmware uses Arduino's setup()/loop() entry points. In a combined
# ESP-IDF/Arduino build, this enables Arduino's app_main implementation.
CONFIG_AUTOSTART_ARDUINO=y

# The AZ-Delivery ESP-32 Dev Kit C V4 has 4 MB of flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Native ESP32 BLE controller with the Bluedroid host. The Advertisement MVP
# scans passively and does not create GATT sessions. ESP-IDF 5.5.2 requires at
# least one GATT role when Bluedroid BLE is enabled; keep only the central/client
# role compiled for the later GATT phase.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_GATTS_ENABLE=n
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BLE_MESH=n
CONFIG_SW_COEXIST_ENABLE=y

# Bluedroid adds IRAM pressure on the original ESP32. These ordinary FreeRTOS
# functions do not run while the flash cache is disabled and can safely remain
# in flash, leaving IRAM for the radio stacks and their interrupt paths.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
